/www/any-auto-register/shared/logs/app.log
/www/any-auto-register/shared/logs/app-error.log
/www/any-auto-register/shared/data/logs/solver.log
/www/any-auto-register/shared/data/logs/external_apps/*.log {
    size 20M
    rotate 5
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    su any-auto-register any-auto-register
}

/www/any-auto-register/shared/logs/nginx-access.log
/www/any-auto-register/shared/logs/nginx-error.log {
    daily
    size 20M
    rotate 5
    missingok
    notifempty
    compress
    delaycompress
    create 0640 www-data any-auto-register
    sharedscripts
    postrotate
        test ! -f /run/nginx.pid || kill -USR1 $(cat /run/nginx.pid)
    endscript
}
