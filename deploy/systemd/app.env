HOST=127.0.0.1
PORT=18081
APP_RELOAD=0
APP_CONDA_ENV=server
APP_RUNTIME_DIR=/www/any-auto-register/shared/data
APP_ENABLE_SOLVER=1
SOLVER_PORT=18889
SOLVER_BIND_HOST=127.0.0.1
LOCAL_SOLVER_URL=http://127.0.0.1:18889
SOLVER_BROWSER_TYPE=camoufox
SOLVER_LOG_PATH=/www/any-auto-register/shared/data/logs/solver.log
PLAYWRIGHT_HEADLESS=1
PLAYWRIGHT_BROWSERS_PATH=/www/any-auto-register/shared/cache/ms-playwright
XDG_CACHE_HOME=/www/any-auto-register/shared/cache
HOME=/www/any-auto-register/shared/home
DATABASE_URL=sqlite:////www/any-auto-register/shared/data/account_manager.db
# Optional direct Codex2API PostgreSQL reader. Keep these unset until a
# dedicated read-only role and a stable loopback/network endpoint are ready.
# CODEX2API_DATABASE_URL=postgresql://account_manager_reader:PASSWORD@127.0.0.1:15432/codex2api
# CODEX2API_DATABASE_TARGET_ID=1
# CODEX2API_DATABASE_URL_2=postgresql://account_manager_reader:PASSWORD@127.0.0.1:15432/codex2api
TASK_RUN_RETENTION_HOURS=12
TASK_HISTORY_RETENTION_DAYS=30
TASK_HISTORY_FAILURE_RETENTION_DAYS=90
TZ=Asia/Shanghai
